# ==============================================================================
# PiMusic Backend - Variables de Entorno de Configuración
# ==============================================================================

# Dirección IP y Puerto de escucha
PIMUSIC_HOST=0.0.0.0
PIMUSIC_PORT=5000

# Directorio de almacenamiento para descargas y biblioteca permanente
# - En Linux / Raspberry Pi: /home/jorge/pi-music-cache
# - En Contenedor Docker: /app/downloads
# - En Windows / Desarrollo local: ./downloads
PIMUSIC_DOWNLOADS_DIR=./downloads

# Orígenes CORS permitidos (separados por coma, o '*' para permitir cualquier origen en red local)
# Ejemplo para producción: http://192.168.1.50:3000,http://localhost:3000
PIMUSIC_CORS_ORIGINS=*

# Ruta al archivo de cookies de YouTube (opcional, para videos con restricción de edad)
# PIMUSIC_COOKIES_FILE=./downloads/system/cookies.txt

# Credenciales de Google Cloud OAuth (opcional, para vinculación de cuentas de YouTube mediante Device Code Flow)
# GOOGLE_DEVICE_CLIENT_ID=
# GOOGLE_DEVICE_CLIENT_SECRET=
